rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'huynhkiencam151102@gmail.com';
    }
    match /orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'huynhkiencam151102@gmail.com';
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'huynhkiencam151102@gmail.com';
    }
  }
}
